# ============================================================
# .dockerignore - Docker 构建上下文排除规则
# 减少构建上下文体积，加速镜像构建，避免将不必要的文件送入构建
# ============================================================

# --- Node.js ---
node_modules
frontend/node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info
.pytest_cache
.coverage
htmlcov
.mypy_cache
.ruff_cache

# --- 虚拟环境 ---
venv
env
.venv
ENV
backend/venv
backend/env

# --- Git ---
.git
.gitignore
.gitattributes

# --- IDE / 编辑器 ---
.idea
.vscode
*.swp
*.swo
*~

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 构建产物（容器内重新构建，不需要宿主机的产物）---
frontend/dist
backend/app/static

# --- 运行时数据（通过数据卷挂载，不打包进镜像）---
backend/app/services/data/*.json
backend/app/services/data/profile_capture_configs.json

# --- 日志 ---
*.log
logs
backend/logs

# --- 上传文件 ---
uploads
backend/uploads

# --- 环境变量文件（避免泄露敏感信息）---
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local

# --- Docker 自身文件（不需要打包进镜像）---
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# --- 部署脚本 ---
deploy-vps.sh

# --- 文档（可选，减小镜像体积）---
docs
*.md
!frontend/README.md

# --- 示例数据 ---
sample_data
